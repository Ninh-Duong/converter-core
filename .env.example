# Đặt API Key của bạn vào đây nếu muốn sử dụng chế độ Vision AI (chính xác 100% cho file scan / ảnh chụp)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Tùy chọn model Gemini muốn sử dụng (mặc định hệ thống tự chọn model tốt nhất khả dụng)
# Ví dụ: gemini-3-flash-preview, gemini-3.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3-flash-preview