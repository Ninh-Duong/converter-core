# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets (Gemini API Key, Tokens & Credentials)
.env
.env.*
*.env
*.key
*api_key*
*apikey*
*gemini*key*
gemini*.txt
credentials.json
secrets/

# User conversion files (prevent uploading private documents)
files/*
!files/.gitkeep
!files/*/.gitkeep

# Temporary Office Lock files
~$*

# OS generated files
.DS_Store
Thumbs.db
*.tmp
*.log

# Build / Distribution
dist/
build/
*.spec
